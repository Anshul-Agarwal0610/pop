{
  "name": "pollify-mobile",
  "version": "1.0.0",
  "main": "index.ts",
  "dependencies": {
    "expo": "~56.0.4",
    "expo-notifications": "^56.0.15",
    "expo-secure-store": "~56.0.4",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
    ,"pollify-nearby": "file:./modules/pollify-nearby"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
    ,"@types/jest": "^29.5.14"
    ,"jest": "^29.7.0"
    ,"ts-jest": "^29.2.5"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "jest --runInBand",
    "verify:android:config": "npx expo config --type public",
    "verify:android:release": "npm run typecheck && npm run verify:android:config",
    "build:android:preview": "npx eas build --platform android --profile preview",
    "build:android:production": "npx eas build --platform android --profile production",
    "submit:android:production": "npx eas submit --platform android --profile production"
  },
  "private": true
}
